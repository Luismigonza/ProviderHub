root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets}]
indent_size = 2

# Entity Framework writes these files, and rewrites them on every migration. Holding machine
# generated code to hand-written standards only means editing it back by hand after each change,
# and an edited migration is a migration that no longer matches the model snapshot.
[**/Migrations/**.cs]
generated_code = true
